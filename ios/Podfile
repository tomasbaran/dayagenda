require 'xcodeproj'
# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-live' => :debug,
  'Profile-live' => :release,
  'Release-live' => :release,
}

# Override conflicting dependencies
pod 'AppAuth', '~> 1.7.6'  # Compatible with google_sign_in_ios
pod 'FirebaseFirestore', '~> 10.25.0'  # Match Firebase SDK version
pod 'GoogleUtilities', '~> 7.13.3'  # Compatible with FirebaseCore

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  # first let Flutter do its thing:
  installer.pods_project.targets.each do |t| 
    flutter_additional_ios_build_settings(t) 
  end

  # now open the Runner project and patch its “Embed Pods Frameworks” phase:
  runner_proj_path = File.expand_path('Runner.xcodeproj', __dir__)
  runner_proj      = Xcodeproj::Project.open(runner_proj_path)
  app_target       = runner_proj.targets.find { |t| t.name == 'Runner' }

  app_target.build_phases.each do |phase|
    # this is the “Embed Pods Frameworks” file‐list phase
    next unless phase.respond_to?(:input_file_list_paths)

    # rewrite any absolute “/Target Support Files/…” to use ${PODS_ROOT}
    phase.input_file_list_paths.map! do |p|
      p.start_with?('/Target Support Files') ? "${PODS_ROOT}#{p}" : p
    end
    phase.output_file_list_paths.map! do |p|
      p.start_with?('/Target Support Files') ? "${PODS_ROOT}#{p}" : p
    end
  end

  runner_proj.save
end
