require 'xcodeproj'

# 1) Target platform
platform :ios, '13.0'

# 2) Disable CocoaPods analytics (speeds up CI)
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# 3) Map Runner’s Xcode configurations to CocoaPods modes
project 'Runner', {
  'Debug-dev'   => :debug,
  'Debug-live'  => :debug,
  'Profile-dev' => :release,
  'Profile-live'=> :release,
  'Release-dev' => :release,
  'Release-live'=> :release
}

# 4) Only override the pods that truly conflict
pod 'AppAuth',           '~> 1.7.6'  # for google_sign_in_ios
pod 'GoogleUtilities',   '~> 7.13.3' # for FirebaseCore

# 5) FlutterFire / Flutter tooling support
def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup

# 6) Install all the Flutter plugins (and transitively Firestore, Auth, etc.)
target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

# 7) Post‐install: apply Flutter settings & patch Embed Pods Frameworks
post_install do |installer|
  # 1) Let Flutter add its own build settings
  installer.pods_project.targets.each do |t|
    flutter_additional_ios_build_settings(t)
  end

  # 2) Open the Xcode project and clear the file‐list entries
  require 'xcodeproj'
  proj       = Xcodeproj::Project.open(File.join(__dir__, 'Runner.xcodeproj'))
  app_target = proj.targets.find { |t| t.name == 'Runner' }

  app_target.build_phases.each do |phase|
    # Only touch the Embed Pods Frameworks run‐script
    next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
    next unless phase.name == 'Embed Pods Frameworks'

    # Clear out any file‐list paths so Xcode uses input_paths instead
    phase.input_file_list_paths  = []
    phase.output_file_list_paths = []
  end

  proj.save
end